# Server
PORT=5000
NODE_ENV=development

# Frontend URL — used for CORS (set to your deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Portfolio

# JWT secret for admin authentication
JWT_SECRET=your_jwt_secret_here

# Resend email API key (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Admin email (fallback for contact form)
ADMIN_EMAIL=your_email@gmail.com

# Cloudinary Configuration (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=sandy_portfolio
